# Configuration du serveur
PORT=3000

# Sécurité Admin
# Définissez le mot de passe pour l'accès au tableau de bord (Ctrl + Shift + A)
ADMIN_PASSWORD=VotreMotDePasseSecret123
# Une clé secrète aléatoire pour crypter les sessions admin
JWT_SECRET=cefc_sarl_super_secret_session_token_key_98765

# Configuration SMTP pour les notifications d'email
# Si vous utilisez Gmail, créez un "Mot de passe d'application" dans votre compte Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-adresse-email@gmail.com
SMTP_PASS=votre-mot-de-passe-d-application

# Email qui recevra les notifications (demandes de devis et rendez-vous)
NOTIFICATION_EMAIL=cefcsarl@gmail.com
